{
  "name": "@local/dsh-paper-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/host.js",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "description": "论文阅读器：在 DSH 右侧栏阅读 PDF 论文（目录、页内搜索、高亮边注、agent 只读工具）",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/host.js",
    "lib/pdf.worker.mjs",
    "lib/ocr",
    "client.js",
    "client.*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-workspace-files"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-workspace-files": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@esbuild/win32-x64": "0.25.12",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "esbuild": "0.25.12",
    "pdfjs-dist": "6.3.289",
    "tesseract.js": "6.0.1",
    "tesseract.js-core": "6.1.2",
    "typescript": "^5.7.2",
    "wasm-feature-detect": "1.10.1"
  }
}
